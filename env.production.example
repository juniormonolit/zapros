# Production environment (copy to .env.production on the server).
# Never commit real secrets. File names starting with .env* are gitignored.

# Yandex Managed PostgreSQL (migrate user or dedicated app user with RLS owner bypass)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6432/zapros?sslmode=require

# Session JWT signing secret (min 32 random characters; rotate on compromise)
AUTH_SECRET=

# Protects POST /api/cron/expire-invites (Bearer token)
CRON_SECRET=

# Optional: NODE_ENV=production is set by Next.js on `next start`
